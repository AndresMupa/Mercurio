# ─────────────────────────────────────────────────────────────────────────────
# Variables que consume docker-compose.yml. Cópialo a `.env` en la raíz:
#     cp .env.example .env
#
# Aquí viven las credenciales de base de datos, y solo aquí: con ellas se crean los
# roles en PostgreSQL y con ellas se conecta la aplicación. Un segundo sitio con las
# mismas contraseñas sería un sitio donde se desincronizan.
#
# La configuración de Laravel (APP_KEY, correo, etc.) está en apps/platform/.env.
# ─────────────────────────────────────────────────────────────────────────────

DB_DATABASE=platform

# Dueño del esquema: ejecuta las migraciones y nada más.
DB_OWNER_ROLE=platform_owner
DB_OWNER_PASSWORD=cambiar_en_cada_entorno

# Runtime: sirve peticiones y colas. Sin BYPASSRLS, sin superusuario, sin tablas propias.
DB_APP_ROLE=platform_app
DB_APP_PASSWORD=cambiar_en_cada_entorno

# Existe solo para inicializar el contenedor y crear los dos roles de arriba.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambiar_en_cada_entorno

# Puertos publicados en la máquina anfitriona.
APP_PORT=8080
VITE_PORT=5173
DB_PORT_HOST=5432
REDIS_PORT_HOST=6379
