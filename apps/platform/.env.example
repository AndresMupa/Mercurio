APP_NAME=Plataforma
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Bogota
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────────────────────
# Base de datos — dos roles separados (PLAN.md A1, SECURITY.md)
#
# platform_owner  dueño del esquema. Ejecuta las migraciones y nada más:
#                     php artisan migrate --database=pgsql_owner
# platform_app    runtime. Sirve peticiones y colas. NO es dueño de ninguna
#                 tabla, NO es superusuario y NO tiene BYPASSRLS. Sin esas tres
#                 condiciones, la RLS forzada y la auditoría append-only son
#                 decoración: el rol podría revertir sus propias restricciones.
#
# El arranque verifica la condición con TenantContext::assertRoleCannotBypassRls().
# ─────────────────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=platform

DB_APP_ROLE=platform_app
DB_APP_PASSWORD=cambiar_en_cada_entorno

DB_OWNER_ROLE=platform_owner
DB_OWNER_PASSWORD=cambiar_en_cada_entorno

DB_SSLMODE=prefer

# El superusuario de PostgreSQL existe solo para arrancar el contenedor y crear
# los dos roles. La aplicación jamás se conecta con él.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambiar_en_cada_entorno

# ─────────────────────────────────────────────────────────────────────────────
# Sesión, caché y colas en Redis.
#
# No en base de datos: las tablas `sessions` y `cache` de Laravel guardan
# user_id, IP y user agent sin tenant_id, y la regla 1 de CLAUDE.md no admite
# una tabla con datos de personas sin tenant_id, política RLS y test de
# aislamiento. Redis evita crear esa excepción en el primer día.
# ─────────────────────────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Solo por HTTPS y sin envio desde terceros. En desarrollo local sin TLS habra que
# poner SESSION_SECURE_COOKIE=false a mano: se prefiere que cueste bajarlo a que
# cueste subirlo.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@plataforma.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
